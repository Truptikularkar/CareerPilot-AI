# =============================================================================
# CareerPilot AI — Environment Configuration Template
# Copy this file to .env and provide your deployment secrets.
# NEVER commit real API keys, passwords, or secret tokens into version control.
# =============================================================================

# Application Environment Mode: LOCAL_PRIVATE, DEMO, or HOSTED_PRIVATE
CAREERPILOT_MODE=LOCAL_PRIVATE

# LLM Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local LLM Fallback (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# External Connectors (Optional - elevated API rate limits)
GITHUB_ACCESS_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database & Storage Configuration
# For LOCAL_PRIVATE: uses ./data/careerpilot.db
# For HOSTED_PRIVATE: supply managed database URL (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=
PERSISTENT_VOLUME_PATH=

# Session & Authentication Security
SESSION_SECRET=
ARGON2_ROUNDS=3
SESSION_EXPIRY_DAYS=30

# Logging & Telemetry
LOG_LEVEL=INFO
DEBUG=false
